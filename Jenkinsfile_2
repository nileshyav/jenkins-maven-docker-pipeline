def gv
pipeline{
    agent any

    parameters {
    choice choices: ['main', 'test'], name: 'branch'

    }


    // environment {

    // }



stages{

    stage('gitclone'){
        when {
            expression{
                     params.branch == "test"
            }
           
        }
        steps{
            script{
                gv = load 'script2.groovy'
                gv.showWorkingDir()
            }
        }
    }

    stage('Building Jar '){
        steps{
            script{
                gv.buildJar()
            }
        }
    }



}
}