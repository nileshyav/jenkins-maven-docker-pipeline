def gv
pipeline{
    agent any

    parameters {
    choice choices: ['main', 'test'], name: 'branch'
    // choice choices:["dockerhub", "ECR"], name: "image_repository"
    
    }

stages{

    stage('gitclone'){
        // when {
        //     expression{
        //              params.branch == "test"
        //     }
           
        // }
        steps{
            script{
                if(params.branch == "main"){
                    gv = load 'script2.groovy'
                    gv.showWorkingDir()
                }
                else{
                    echo "you are not in main branch"
                }
            }
        }
    }

    stage('Building Jar '){
        steps{
            script{
                gv.buildJar()
            }
        }
    }

    stage("Build image"){
        steps{
            script{
                gv.buildImage()
            }
        }
    }

    stage("push image to dockerhub"){
        steps{
            input message: 'Do you want to deploy',
            ok: 'OK',
            parameters: [choice(choices: ['DEV', 'Stage', 'Prod'],
            name: 'ENV')]

            script{
                if (ENV == "Prod"){
                    gv.push_dockerhub()
                }
                else{
                    sh 'echo "Deploying to $ENV"'
                }
            }
        }
    }



}
}