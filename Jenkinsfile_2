def gv
pipeline{
    agent any

stages{

    stage('gitclone'){
        
        steps{
            script{
                
                    gv = load 'script2.groovy'
                    gv.showWorkingDir()
            
            }
        }
    }

    stage('Building Jar '){
        steps{
            script{
                gv.buildJar()
            }
        }
    }

    stage("Build image"){
        when{
            expression{
                BRANCH_NAME == 'main'
            }
        }
        steps{
            script{
                gv.buildImage()
            }
        }
    }

    stage("push image to dockerhub"){
        steps{
            input message: 'Do you want to deploy',
            ok: 'OK',
            parameters: [choice(choices: ['DEV', 'Stage', 'Prod'],
            name: 'ENV')]

            script{
                if (ENV == "Prod"){
                    gv.push_dockerhub()
                }
                else{
                    sh 'echo "Deploying to $ENV"'
                }
            }
        }
    }
}
}