pipeline {
    agent any
    

    stages {
        stage('github clone') {
            steps {
                sh "ls -alh && pwd"
                // sh 'rm -rf jenkins-maven-docker-pipeline'
            //   sh 'git clone https://github.com/nileshyav/jenkins-maven-docker-pipeline && cd jenkins-maven-docker-pipeline && pwd && ls -alh'
            }
        }
        stage('Build jar file'){
            steps {
                // sh 'cd jenkins-maven-docker-pipeline &&  mvn package'
                sh 'mvn clean package && pwd'
                
                
            }
        }
        stage('build docker image'){
            steps{
                sh 'pwd  && docker build -t javaapp .'
                sh 'docker tag javaapp inilesh/java-maven-app:v1'
            }
            
        }
        stage('Deploying app'){
            steps{
                // sh 'pwd && docker run -d -p 80:8080 javaapp '
                withCredentials([usernamePassword(credentialsId: 'dockerhub_auth', passwordVariable: 'pass', usernameVariable: 'user')]) {
                
                sh '''
                echo "hello"
                echo "$user"
                echo "$pass" | docker login -u "$user" --password-stdin
                docker push inilesh/java-maven-app:v1
                '''
            }
               

            }
        }
        
            
        }
    }

